#!/bin/bash
# This is the default assemble script
# It does NOT copy HTML files or generate info.html yet

echo "Running default assemble script..."

# Copy source HTML files from /tmp/src to current working directory
if [ -d /tmp/src ]; then
  cp -Rf /tmp/src/*.html ./
fi

# Generate build date in YYYY-mm-dd format
DATE=$(date "+%F")

# Create info.html with build date and required text
echo "$DATE" > ./info.html
echo "Your info.html is working if you see this." >> ./info.html
# Source the default assemble from the builder image
if [ -f /usr/libexec/s2i/assemble ]; then
  /usr/libexec/s2i/assemble
fi
