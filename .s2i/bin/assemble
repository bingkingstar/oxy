#!/bin/bash
# This is the default assemble script
# It does NOT copy HTML files or generate info.html yet

echo "Running default assemble script..."

# Target OpenShift S2I application source directory explicitly
TARGET_DIR="${APP_ROOT:-/opt/app-root}/src"

# Copy all HTML files from /tmp/src to source directory
if [ -d /tmp/src ]; then
  cp -Rf /tmp/src/*.html "${TARGET_DIR}/"
fi

# Generate build date in YYYY-mm-dd format
DATE=$(date "+%F")

# Create info.html with date and required text
echo "$DATE" > "${TARGET_DIR}/info.html"
echo "Astra inclinant, sed non obligant" >> "${TARGET_DIR}/info.html"

# Source the default assemble from the builder image
if [ -f /usr/libexec/s2i/assemble ]; then
  /usr/libexec/s2i/assemble
fi
