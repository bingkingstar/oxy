#!/bin/bash
# This is the default assemble script
# It does NOT copy HTML files or generate info.html yet
set -eo pipefail

echo "Running default assemble script..."

# Option A: Copying source files to htdocs without removing existing files
if [ -d /tmp/src ]; then
  # Use cp without force-remove, or copy content directly
  cp -r /tmp/src/* htdocs/ 2>/dev/null || cp -r /tmp/src/* ./
fi

# Option B: Writing info.html directly
DATE=$(date "+%F")
cat <<EOF > htdocs/info.html
$DATE
Your info.html is working if you see this.
EOF

echo "---> Build completed successfully."
