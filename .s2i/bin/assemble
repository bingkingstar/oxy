#!/bin/bash
# This is the default assemble script
# It does NOT copy HTML files or generate info.html yet
set -eo pipefail

echo "Running default assemble script..."

# Set target directory to HTTPD document root
TARGET_DIR="htdocs"

# Ensure target directory exists
mkdir -p "${TARGET_DIR}"

# 1. Copy HTML files from /tmp/src to htdocs
if [ -d /tmp/src ]; then
  cp -Rf /tmp/src/*.html "${TARGET_DIR}/"
fi

# 2. Generate build date
DATE=$(date "+%F")

# 3. Create info.html in htdocs
echo "$DATE" > "${TARGET_DIR}/info.html"
echo "Your info.html is working if you see this." >> "${TARGET_DIR}/info.html"

# Source the default assemble from the builder image
if [ -f /usr/libexec/s2i/assemble ]; then
  /usr/libexec/s2i/assemble
fi
